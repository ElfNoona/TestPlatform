# ─── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_USER=examuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=examplatform
DATABASE_URL=postgresql://examuser:changeme@localhost:5432/examplatform

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Backend ────────────────────────────────────────────────────────────────
BACKEND_PORT=4000
JWT_SECRET=change-me-in-production
# TODO: Teacher auth provider not yet chosen — magic link vs Google OAuth allowlist
# See docs/decisions.md #1
TEACHER_AUTH_PROVIDER=todo
GOOGLE_CLIENT_ID=todo
GOOGLE_CLIENT_SECRET=todo
MAGIC_LINK_SECRET=todo
TEACHER_ALLOWLIST_EMAILS=teacher@example.com

# ─── Compiler Service ────────────────────────────────────────────────────────
COMPILER_API_PORT=5000
EXEC_CONCURRENCY=4
# TODO: tune EXEC_CONCURRENCY after rehearsal run with 20-student batch (decisions.md #5)
DOCKER_SANDBOX_IMAGE=exam-platform/dart-sandbox:latest

# ─── Grading Service ─────────────────────────────────────────────────────────
GRADING_PORT=6000
# TODO: AI provider not yet locked in — fill in the relevant key
OPENAI_API_KEY=sk-todo
# GEMINI_API_KEY=todo
# ANTHROPIC_API_KEY=todo
AI_GRADING_PROVIDER=todo

# ─── Proctoring Service ──────────────────────────────────────────────────────
PROCTORING_PORT=7000
# Storage provider: 'local' (dev default) | 's3' (AWS S3) | 'r2' (Cloudflare R2)
MEDIA_STORAGE_PROVIDER=local

# ─── AWS S3 (set MEDIA_STORAGE_PROVIDER=s3 to activate) ──────────────────────
# Region: ap-south-1 (Mumbai) recommended for India-based candidates
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-iam-access-key-id
AWS_SECRET_ACCESS_KEY=your-iam-secret-access-key
AWS_S3_BUCKET_NAME=exam-proctoring-media

# ─── Cloudflare R2 (set MEDIA_STORAGE_PROVIDER=r2 to activate) ───────────────
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=exam-proctoring-media
